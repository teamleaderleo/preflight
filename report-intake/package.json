{
  "name": "@preflight/report-intake",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "type": "module",
  "scripts": {
    "benchmark:dataset": "node scripts/benchmark-dataset.mjs",
    "canary": "node scripts/canary.mjs",
    "check": "npm run typecheck && npm test && npm run test:operator",
    "cf-typegen": "wrangler types --include-runtime false",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:operator": "node --test scripts/*.node-test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "overrides": {
    "undici": "7.29.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260817.1",
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@types/node": "26.4.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.123.0"
  }
}
