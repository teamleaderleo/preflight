{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "preflight-report-intake",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "r2_buckets": [
    {
      "binding": "REPORTS",
      "bucket_name": "preflight-reports"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DAILY_REPORT_QUOTA",
        "class_name": "DailyReportQuota"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DailyReportQuota"]
    }
  ],
  "ratelimits": [
    {
      "name": "CASE_CREATION_RATE_LIMITER",
      "namespace_id": "424001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "MUTATION_RATE_LIMITER",
      "namespace_id": "424002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "vars": {
    "GRANT_TTL_SECONDS": "600",
    "MAX_UPLOAD_BYTES": "6291456",
    "PUBLIC_ORIGIN": "https://preflight-report-intake.leoli-082000.workers.dev",
    "RETENTION_DAYS": "14"
  }
}
