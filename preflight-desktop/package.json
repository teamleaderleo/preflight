{
  "name": "starsector-preflight-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "A desktop performance launcher for Starsector",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teamleaderleo/preflight.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "verify": "npm run test:release && npm test && npm run build && cargo test --locked --manifest-path src-tauri/Cargo.toml && cargo clippy --locked --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "test:release": "npm run engine:prepare && npm run test:release:prepared",
    "test:release:prepared": "node --test scripts/*.node-test.mjs",
    "test:watch": "vitest",
    "engine:prepare": "node scripts/prepare-engine.mjs",
    "engine:prepare:verified": "node scripts/prepare-engine.mjs --use-verified-jar",
    "engine:verify": "node scripts/verify-engine.mjs",
    "desktop:collect": "node scripts/collect-bundles.mjs",
    "desktop:clean": "node scripts/clean-bundle-output.mjs",
    "desktop:exercise-install": "node scripts/exercise-native-install.mjs",
    "desktop:fusion-acceptance": "node scripts/fusion-acceptance.mjs",
    "desktop:verify-package": "node scripts/verify-native-package.mjs",
    "desktop:verify-installed": "node scripts/verify-installed-engine.mjs",
    "desktop:test-package": "npm run desktop:build && npm run desktop:verify-package && npm run desktop:exercise-install",
    "release:version": "node scripts/set-release-version.mjs",
    "desktop:dev": "npm run engine:prepare && tauri dev",
    "desktop:build": "npm run engine:prepare && npm run desktop:clean && tauri build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/orbitron": "5.3.0",
    "@fontsource/b612-mono": "5.3.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.1.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "30.0.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
