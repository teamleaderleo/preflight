{
  "name": "starsector-preflight-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "A desktop performance launcher for Starsector",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teamleaderleo/preflight.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:release": "node --test scripts/*.node-test.mjs",
    "test:watch": "vitest",
    "engine:prepare": "node scripts/prepare-engine.mjs",
    "engine:prepare:verified": "node scripts/prepare-engine.mjs --use-verified-jar",
    "desktop:collect": "node scripts/collect-bundles.mjs",
    "desktop:dev": "npm run engine:prepare && tauri dev",
    "desktop:build": "npm run engine:prepare && tauri build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/orbitron": "5.3.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.1.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "30.0.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
