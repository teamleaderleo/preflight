{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Starsector Preflight",
  "version": "0.1.0",
  "identifier": "dev.starsector.preflight",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Starsector Preflight",
        "width": 1040,
        "height": 700,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "A friendly launch companion for Starsector",
    "longDescription": "Starsector Preflight finds your installation, launches the game with safe optimizations and run notes, and keeps caches separate from your game and saves.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "target/engine/": "engine/"
    }
  }
}
