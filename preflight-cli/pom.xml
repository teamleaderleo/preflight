<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.starsector.preflight</groupId>
    <artifactId>starsector-preflight</artifactId>
    <version>0.1.0</version>
  </parent>
  <artifactId>preflight-cli</artifactId>

  <dependencies>
    <dependency>
      <groupId>dev.starsector.preflight</groupId>
      <artifactId>preflight-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.starsector.preflight</groupId>
      <artifactId>preflight-agent</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Pure Java: preparation can decode the same WebP assets as Starsector without loading
         the game's x86-only native ImageIO plug-in on Apple Silicon. -->
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-webp</artifactId>
      <version>${twelvemonkeys.version}</version>
    </dependency>
    <!-- The JDK 17 Unix provider implements no-option Files.move with a check/rename sequence that
         cannot supply no-replace commit semantics. JNA calls the OS exclusive-rename primitive
         directly on Linux/macOS and MoveFileExW without replacement on Windows. -->
    <dependency>
      <groupId>net.java.dev.jna</groupId>
      <artifactId>jna</artifactId>
      <version>5.19.1</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>preflight</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <relocations>
                <relocation>
                  <pattern>org.objectweb.asm</pattern>
                  <shadedPattern>dev.starsector.preflight.internal.asm</shadedPattern>
                </relocation>
              </relocations>
              <transformers>
                <!-- ImageIO discovers WebPReader through META-INF/services. Keep that registry
                     when dependencies are folded into the executable jar. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <Main-Class>dev.starsector.preflight.cli.PreflightCli</Main-Class>
                    <Implementation-Version>${project.version}</Implementation-Version>
                    <Premain-Class>dev.starsector.preflight.agent.PreflightAgent</Premain-Class>
                    <Agent-Class>dev.starsector.preflight.agent.PreflightAgent</Agent-Class>
                    <Can-Redefine-Classes>false</Can-Redefine-Classes>
                    <Can-Retransform-Classes>false</Can-Retransform-Classes>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.5.6</version>
        <configuration>
          <!-- Integration tests launch the packaged CLI in fresh Java children. Give the test JVM
               and every child it spawns the same build-local home so launch bookkeeping, leases,
               and playtime history can never reach the operator's real ~/.starsector-preflight. -->
          <environmentVariables>
            <JAVA_TOOL_OPTIONS>-Duser.home="${project.build.directory}/test-user-home"</JAVA_TOOL_OPTIONS>
          </environmentVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>