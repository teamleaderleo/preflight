{
  "format": "starsector-preflight-smoke-v1",
  "name": "campaign-simulation-combat-1000dp-thin",
  "timeoutSeconds": 360,
  "launch": {
    "preset": "fast",
    "textureStorage": "balanced",
    "profile": null,
    "recording": "none"
  },
  "steps": [
    {"id":"menu","kind":"wait-state","state":"main-menu-interactive","timeoutSeconds":90},
    {"id":"continue","kind":"click","target":"main-menu.continue"},
    {"id":"campaign","kind":"wait-state","state":"campaign-ready","timeoutSeconds":120},
    {"id":"ensure-paused","kind":"click","target":"campaign.pause"},
    {"id":"prepare-simulation-fleet","kind":"click","target":"campaign.prepare-combat-fixture"},
    {"id":"fixture-settle","kind":"wait-duration","durationMillis":1500},
    {"id":"verify-simulation-fleet","kind":"click","target":"campaign.verify-combat-fixture"},
    {"id":"open-fleet","kind":"press-key","key":"f"},
    {"id":"fleet-settle","kind":"wait-duration","durationMillis":1000},
    {"id":"open-refit","kind":"press-key","key":"r"},
    {"id":"refit-settle","kind":"wait-duration","durationMillis":1500},
    {"id":"open-simulation","kind":"press-key","key":"n"},
    {"id":"simulation","kind":"wait-state","state":"simulation-ready","timeoutSeconds":30},
    {"id":"opponents-all","kind":"click","target":"simulation.opponents.all"},
    {"id":"opponents-deploy","kind":"click","target":"simulation.opponents.deploy"},
    {"id":"allies-tab","kind":"click","target":"simulation.allies.select"},
    {"id":"allies-all","kind":"click","target":"simulation.allies.all"},
    {"id":"allies-deploy","kind":"click","target":"simulation.allies.deploy"},
    {"id":"engage","kind":"click","target":"simulation.engage"},
    {"id":"combat","kind":"wait-state","state":"combat-ready","timeoutSeconds":30},
    {"id":"prepare-symmetric-stress","kind":"click","target":"combat.prepare-symmetric-1000dp-fixture"},
    {"id":"stress-settle","kind":"wait-duration","durationMillis":1500},
    {"id":"autopilot","kind":"press-key","key":"u"},
    {"id":"close-command-map","kind":"press-key","key":"tab"},
    {"id":"command-map-close-settle","kind":"wait-duration","durationMillis":750},
    {"id":"enable-two-times-speed","kind":"press-key","key":"capslock"},
    {"id":"ensure-combat-unpaused","kind":"click","target":"combat.unpause"},
    {"id":"capture-viewport","kind":"click","target":"combat.capture-viewport"},
    {"id":"zoom-out","kind":"click","target":"combat.set-stress-viewport"},
    {"id":"camera-settle","kind":"wait-duration","durationMillis":1500},
    {"id":"verify-zoom-out","kind":"click","target":"combat.verify-zoom-out"},
    {"id":"begin-frame-window","kind":"click","target":"combat.begin-frame-window"},
    {"id":"combat-sample-1040dp","kind":"wait-duration","durationMillis":30000},
    {"id":"capture","kind":"capture","artifacts":["frame-report","adapter-health","log-tail"]}
  ]
}
