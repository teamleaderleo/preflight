{
  "format": "starsector-preflight-smoke-v1",
  "name": "campaign-sample-paused-unpaused",
  "timeoutSeconds": 360,
  "launch": {
    "preset": "fast",
    "textureStorage": "balanced",
    "profile": null,
    "recording": "sample",
    "campaignTimes": false,
    "smoothFramePacing": false
  },
  "steps": [
    {
      "id": "menu",
      "kind": "wait-state",
      "state": "main-menu-interactive",
      "timeoutSeconds": 180
    },
    {
      "id": "continue",
      "kind": "click",
      "target": "main-menu.continue"
    },
    {
      "id": "campaign",
      "kind": "wait-state",
      "state": "campaign-ready",
      "timeoutSeconds": 120
    },
    {
      "id": "observe-initial-pause-state",
      "kind": "wait-duration",
      "durationMillis": 3000
    },
    {
      "id": "ensure-paused",
      "kind": "click",
      "target": "campaign.pause"
    },
    {
      "id": "paused-warmup",
      "kind": "wait-duration",
      "durationMillis": 27000
    },
    {
      "id": "paused-settled",
      "kind": "wait-duration",
      "durationMillis": 45000
    },
    {
      "id": "unpause",
      "kind": "click",
      "target": "campaign.unpause"
    },
    {
      "id": "unpaused-transition",
      "kind": "wait-duration",
      "durationMillis": 5000
    },
    {
      "id": "unpaused-settled",
      "kind": "wait-duration",
      "durationMillis": 45000
    },
    {
      "id": "restore-paused",
      "kind": "click",
      "target": "campaign.pause"
    }
  ]
}
