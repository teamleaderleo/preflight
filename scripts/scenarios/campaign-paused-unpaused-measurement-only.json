{
  "format": "starsector-preflight-smoke-v1",
  "name": "campaign-paused-unpaused-measurement-only",
  "timeoutSeconds": 420,
  "launch": {
    "preset": "measurement-only",
    "textureStorage": "balanced",
    "profile": null
  },
  "steps": [
    {"id":"menu","kind":"wait-state","state":"main-menu-interactive","timeoutSeconds":180},
    {"id":"continue","kind":"click","target":"main-menu.continue"},
    {"id":"campaign","kind":"wait-state","state":"campaign-ready","timeoutSeconds":120},
    {"id":"observe-initial-pause-state","kind":"wait-duration","durationMillis":3000},
    {"id":"activate-game","kind":"activate-window"},
    {"id":"ensure-paused","kind":"click","target":"campaign.pause"},
    {"id":"paused-warmup","kind":"wait-duration","durationMillis":27000},
    {"id":"paused-settled","kind":"wait-duration","durationMillis":45000},
    {"id":"unpause","kind":"click","target":"campaign.unpause"},
    {"id":"unpaused-transition","kind":"wait-duration","durationMillis":5000},
    {"id":"unpaused-settled","kind":"wait-duration","durationMillis":45000},
    {"id":"restore-paused","kind":"click","target":"campaign.pause"},
    {"id":"capture","kind":"capture","artifacts":["frame-report","adapter-health","log-tail"]},
    {"id":"quit","kind":"quit"}
  ]
}
