{
  "format": "starsector-preflight-smoke-v1",
  "name": "combat-roam-temporary",
  "timeoutSeconds": 240,
  "launch": {
    "preset": "fast",
    "textureStorage": "balanced",
    "profile": null
  },
  "steps": [
    {
      "id": "menu",
      "kind": "wait-state",
      "state": "main-menu-ready",
      "timeoutSeconds": 90
    },
    {
      "id": "continue",
      "kind": "click",
      "target": "main-menu.continue"
    },
    {
      "id": "combat",
      "kind": "wait-state",
      "state": "combat-ready",
      "timeoutSeconds": 120
    },
    {
      "id": "thrust",
      "kind": "hold-key",
      "key": "w",
      "durationMillis": 3000
    },
    {
      "id": "capture",
      "kind": "capture",
      "artifacts": [
        "screenshot",
        "log-tail",
        "adapter-health",
        "frame-report"
      ]
    },
    {
      "id": "quit",
      "kind": "quit"
    }
  ]
}
