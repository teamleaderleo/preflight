#!/usr/bin/env bash
set -Eeuo pipefail

launcher_version="1"
repository="teamleaderleo/preflight"
image="localhost/starsector-preflight-build:1"
memory="768m"
cpus="0.85"
pids="512"
cgroup_manager="cgroupfs"
seed_cache="/var/lib/starsector-preflight-ci/m2"
max_archive_bytes="134217728"
maven_opts="-Xmx320m -XX:MaxMetaspaceSize=160m -Djava.io.tmpdir=/tmp"

fail() {
  echo "starsector-preflight-ci-v${launcher_version}: $*" >&2
  exit "${2:-1}"
}

usage() {
  cat <<'USAGE'
Usage: starsector-preflight-ci-v1 COMMIT_SHA SUITE NETWORK_MODE

COMMIT_SHA    Exact 40-character lowercase Git commit SHA.
SUITE         full | focused | analysis | coverage | package
NETWORK_MODE  online | offline
USAGE
}

[[ $# -eq 3 ]] || { usage >&2; exit 64; }
sha="$1"
suite="$2"
network_mode="$3"

[[ "$sha" =~ ^[0-9a-f]{40}$ ]] || fail "commit SHA must be exactly 40 lowercase hexadecimal characters" 64
case "$suite" in
  full|focused|analysis|coverage|package) ;;
  *) fail "unsupported verification suite: $suite" 64 ;;
esac
case "$network_mode" in
  online|offline) ;;
  *) fail "network mode must be online or offline" 64 ;;
esac

[[ "$(id -u)" -ne 0 ]] || fail "refusing to run as root" 77
self="$(readlink -f -- "$0")"
[[ "$(stat -c '%u' -- "$self")" == "0" ]] || fail "launcher must be owned by root: $self" 77
mode_bits="$(stat -c '%a' -- "$self")"
(( (8#$mode_bits & 022) == 0 )) || fail "launcher must not be writable by group or others: $self" 77

for command_name in curl podman sha256sum mktemp stat readlink jq find grep awk; do
  command -v "$command_name" >/dev/null 2>&1 || fail "required command is missing: $command_name" 69
done

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
[[ -d "$XDG_RUNTIME_DIR" ]] || fail "missing rootless Podman runtime directory: $XDG_RUNTIME_DIR" 69

podman_info="$(podman info --format json)" || fail "podman info failed" 69
rootless="$(jq -r '.host.security.rootless // false' <<<"$podman_info" 2>/dev/null || printf false)"
[[ "$rootless" == "true" ]] || fail "Podman must be rootless" 77
podman image exists "$image" || fail "required build image is not installed: $image" 69

seed_args=()
if [[ -d "$seed_cache" ]]; then
  [[ "$(stat -c '%u' -- "$seed_cache")" == "0" ]] || fail "dependency seed cache must be root-owned: $seed_cache" 77
  seed_mode="$(stat -c '%a' -- "$seed_cache")"
  (( (8#$seed_mode & 022) == 0 )) || fail "dependency seed cache must not be writable by group or others: $seed_cache" 77
  if find "$seed_cache" -xdev \( ! -user root -o -perm /022 \) -print -quit | grep -q .; then
    fail "dependency seed cache contains entries writable by the runner account" 77
  fi
  seed_args+=(--volume "$seed_cache:/maven-seed:ro")
elif [[ "$network_mode" == "offline" ]]; then
  fail "offline verification requires a root-owned seed cache at $seed_cache" 69
fi

run_root="$(mktemp -d --tmpdir="$XDG_RUNTIME_DIR" preflight-ci-v1.XXXXXXXX)"
archive="$run_root/source.tar.gz"
workspace="$run_root/workspace"
run_cache="$run_root/maven-cache"
mkdir -m 0700 -- "$workspace" "$run_cache"
container_name="starsector-preflight-${suite}-$$"
podman_runtime=(podman --cgroup-manager="$cgroup_manager")

cleanup() {
  "${podman_runtime[@]}" rm --force "$container_name" >/dev/null 2>&1 || true
  rm -rf -- "$run_root"
}
trap cleanup EXIT INT TERM

archive_url="https://github.com/${repository}/archive/${sha}.tar.gz"
curl --fail --location --silent --show-error \
  --proto '=https' --tlsv1.2 \
  --max-filesize "$max_archive_bytes" \
  --output "$archive" \
  "$archive_url"
chmod 0600 -- "$archive"
archive_sha256="$(sha256sum "$archive" | awk '{print $1}')"
[[ -s "$archive" ]] || fail "downloaded source archive is empty" 69

maven_args=(--batch-mode --no-transfer-progress "-Dmaven.repo.local=/maven-cache/repository")
network_args=()
if [[ "$network_mode" == "offline" ]]; then
  network_args+=(--network=none)
  maven_args+=(--offline)
fi
case "$suite" in
  full) maven_args+=(verify) ;;
  focused) maven_args+=(-pl preflight-agent,preflight-cli -am verify) ;;
  analysis) maven_args+=(-Panalysis verify) ;;
  coverage) maven_args+=(-Pcoverage verify) ;;
  package) maven_args+=(-DskipTests package) ;;
esac

image_id="$(podman image inspect --format '{{.Id}}' "$image")"
image_digest="$(podman image inspect --format '{{index .RepoDigests 0}}' "$image" 2>/dev/null || true)"
[[ -n "$image_digest" && "$image_digest" != "<no value>" ]] || image_digest="unavailable"
printf 'launcherVersion=%s\nsourceSha=%s\nsourceArchiveSha256=%s\nsuite=%s\nnetworkMode=%s\nimage=%s\nimageId=%s\nimageDigest=%s\nlimits=memory:%s cpus:%s pids:%s\n' \
  "$launcher_version" "$sha" "$archive_sha256" "$suite" "$network_mode" \
  "$image" "$image_id" "$image_digest" "$memory" "$cpus" "$pids"

fixed_entrypoint='set -Eeuo pipefail
mkdir -p /workspace/src /tmp/home
if [[ -d /maven-seed ]]; then
  cp -a /maven-seed/. /maven-cache/
fi
tar --extract --gzip --file /input/source.tar.gz --strip-components=1 --directory /workspace/src
cd /workspace/src
exec mvn "$@"'

set +e
"${podman_runtime[@]}" run --rm \
  --name "$container_name" \
  --pull=never \
  --userns=keep-id \
  --cap-drop=all \
  --security-opt=no-new-privileges \
  --read-only \
  --memory="$memory" \
  --cpus="$cpus" \
  --pids-limit="$pids" \
  --tmpfs /tmp:rw,nosuid,nodev,size=192m \
  "${network_args[@]}" \
  --env "HOME=/tmp/home" \
  --env "MAVEN_CONFIG=/maven-cache" \
  --env "MAVEN_OPTS=$maven_opts" \
  --volume "$archive:/input/source.tar.gz:ro" \
  --volume "$workspace:/workspace:rw" \
  --volume "$run_cache:/maven-cache:rw" \
  "${seed_args[@]}" \
  --workdir /workspace \
  "$image" \
  /bin/bash -c "$fixed_entrypoint" -- "${maven_args[@]}"
status=$?
set -e

exit "$status"
